rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net — Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'mominkhan404586@gmail.com';
    }

    function isSuperCentralAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.accessLevel == 'Super Central Admin'
      );
    }

    function isReviewerAdmin() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveUserDoc() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && (!('isActive' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true);
    }

    function isActiveSchoolAdminOf(schoolId) {
      return isActiveUserDoc()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'school_admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    function isActiveSchoolTeacherOf(schoolId) {
      return isActiveUserDoc()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    function belongsToActiveSchool(schoolId) {
      return isActiveUserDoc()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // 3. Entity Validators (Zero DB Reads — Static Validation Blueprints)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'schoolId', 'teacherId', 'studentId', 'status', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
        && data.role in ['central_admin', 'school_admin', 'teacher', 'guardian', 'student', 'pending']
        && data.status in ['active', 'pending', 'suspended', 'rejected', 'deactivated']
        && (!('isActive' in data) || data.isActive is bool)
        && (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64))
        && (!('teacherId' in data) || (data.teacherId is string && data.teacherId.size() <= 64))
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data) {
      return data.keys().hasAll(['uid', 'lang', 'theme', 'fontSize', 'pushNotifications', 'emailNotifications', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'lang', 'theme', 'fontSize', 'pushNotifications', 'emailNotifications', 'updatedAt'])
        && isValidId(data.uid)
        && data.lang in ['bn', 'en']
        && data.theme in ['light', 'dark', 'system']
        && data.fontSize in ['small', 'normal', 'large']
        && data.pushNotifications is bool
        && data.emailNotifications is bool
        && data.updatedAt is timestamp;
    }

    function isValidAdminRegistry(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'accessLevel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'accessLevel', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.accessLevel in ['Super Central Admin', 'Audit Officer', 'Regional Reviewer']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolSummary(data) {
      return data.keys().hasAll(['schoolId', 'ownerUid', 'nameBn', 'nameEn', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schoolId', 'ownerUid', 'nameBn', 'nameEn', 'eiin', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.ownerUid)
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 200
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200
        && (!('eiin' in data) || (data.eiin is string && data.eiin.size() <= 32))
        && data.status in ['pending', 'under_review', 'active', 'suspended', 'deactivated']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacherProfile(data) {
      return data.keys().hasAll(['teacherId', 'schoolId', 'ownerUid', 'teacherCode', 'nameBn', 'nameEn', 'designation', 'mobile', 'status', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherId', 'schoolId', 'ownerUid', 'teacherCode', 'nameBn', 'nameEn', 'designation', 'mobile', 'email', 'status', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.teacherId) && data.teacherId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.ownerUid)
        && data.teacherCode is string && data.teacherCode.size() >= 1 && data.teacherCode.size() <= 64
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.designation is string && data.designation.size() <= 80
        && data.mobile is string && data.mobile.size() <= 24
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.status in ['active', 'pending', 'suspended', 'rejected', 'deactivated']
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['studentId', 'schoolId', 'ownerUid', 'permanentId', 'nameBn', 'nameEn', 'className', 'section', 'roll', 'guardianMobile', 'status', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'schoolId', 'ownerUid', 'guardianUid', 'permanentId', 'nameBn', 'nameEn', 'className', 'section', 'roll', 'guardianMobile', 'status', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId) && data.studentId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.ownerUid)
        && (!('guardianUid' in data) || (data.guardianUid is string && data.guardianUid.size() <= 128))
        && data.permanentId is string && data.permanentId.size() >= 1 && data.permanentId.size() <= 64
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.className is string && data.className.size() <= 64
        && data.section is string && data.section.size() <= 32
        && data.roll is int && data.roll >= 1 && data.roll <= 99999
        && data.guardianMobile is string && data.guardianMobile.size() <= 24
        && data.status in ['active', 'pending', 'suspended', 'rejected', 'deactivated']
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassSectionRecord(data) {
      return data.keys().hasAll(['classId', 'schoolId', 'ownerUid', 'className', 'section', 'roomNo', 'capacity', 'enrolledCount', 'classTeacherId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'schoolId', 'ownerUid', 'className', 'section', 'roomNo', 'capacity', 'enrolledCount', 'classTeacherId', 'createdAt', 'updatedAt'])
        && isValidId(data.classId) && data.classId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.ownerUid)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 64
        && data.section is string && data.section.size() >= 1 && data.section.size() <= 32
        && data.roomNo is string && data.roomNo.size() <= 32
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 500
        && data.enrolledCount is int && data.enrolledCount >= 0 && data.enrolledCount <= 500
        && data.classTeacherId is string && data.classTeacherId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubjectRecord(data) {
      return data.keys().hasAll(['subjectId', 'schoolId', 'ownerUid', 'code', 'nameBn', 'nameEn', 'classRange', 'fullMarks', 'passMarks', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['subjectId', 'schoolId', 'ownerUid', 'code', 'nameBn', 'nameEn', 'classRange', 'fullMarks', 'passMarks', 'createdAt', 'updatedAt'])
        && isValidId(data.subjectId) && data.subjectId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.ownerUid)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.classRange is string && data.classRange.size() <= 64
        && data.fullMarks is int && data.fullMarks >= 1 && data.fullMarks <= 1000
        && data.passMarks is int && data.passMarks >= 0 && data.passMarks <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['attendanceId', 'schoolId', 'studentId', 'recordedByUid', 'dateIso', 'status', 'source', 'guardianNotified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['attendanceId', 'schoolId', 'studentId', 'recordedByUid', 'dateIso', 'status', 'source', 'guardianNotified', 'createdAt', 'updatedAt'])
        && isValidId(data.attendanceId) && data.attendanceId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.studentId) && data.studentId.size() <= 64
        && isValidId(data.recordedByUid)
        && data.dateIso is string && data.dateIso.size() >= 8 && data.dateIso.size() <= 20
        && data.status in ['present', 'late', 'absent']
        && data.source in ['auto_camera', 'manual_teacher', 'kiosk']
        && data.guardianNotified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExamSummaryRecord(data) {
      return data.keys().hasAll(['examId', 'schoolId', 'createdByUid', 'titleBn', 'titleEn', 'className', 'dateRange', 'status', 'centralPublished', 'fullMarks', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['examId', 'schoolId', 'createdByUid', 'titleBn', 'titleEn', 'className', 'dateRange', 'status', 'centralPublished', 'fullMarks', 'createdAt', 'updatedAt'])
        && isValidId(data.examId) && data.examId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.createdByUid)
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 200
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 200
        && data.className is string && data.className.size() <= 64
        && data.dateRange is string && data.dateRange.size() <= 100
        && data.status in ['scheduled', 'marks_entry', 'published', 'held']
        && data.centralPublished is bool
        && data.fullMarks is int && data.fullMarks >= 1 && data.fullMarks <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResultRecord(data) {
      return data.keys().hasAll(['resultId', 'examId', 'schoolId', 'studentId', 'publishedByUid', 'subjectEn', 'totalMarks', 'fullMarks', 'passed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['resultId', 'examId', 'schoolId', 'studentId', 'publishedByUid', 'subjectEn', 'totalMarks', 'fullMarks', 'passed', 'createdAt', 'updatedAt'])
        && isValidId(data.resultId) && data.resultId.size() <= 64
        && isValidId(data.examId) && data.examId.size() <= 64
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && isValidId(data.studentId) && data.studentId.size() <= 64
        && isValidId(data.publishedByUid)
        && data.subjectEn is string && data.subjectEn.size() >= 1 && data.subjectEn.size() <= 80
        && data.totalMarks is int && data.totalMarks >= 0 && data.totalMarks <= 1000
        && data.fullMarks is int && data.fullMarks >= 1 && data.fullMarks <= 1000
        && data.passed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplicationRecord(data) {
      return data.keys().hasAll(['applicationId', 'applicantUid', 'requestedRole', 'applicationType', 'schoolId', 'applicantName', 'targetEntityId', 'status', 'details', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['applicationId', 'applicantUid', 'requestedRole', 'applicationType', 'schoolId', 'applicantName', 'targetEntityId', 'status', 'details', 'reviewedByUid', 'reviewNote', 'createdAt', 'updatedAt'])
        && isValidId(data.applicationId) && data.applicationId.size() <= 64
        && isValidId(data.applicantUid)
        && data.requestedRole in ['central_admin', 'school_admin', 'teacher', 'guardian', 'student']
        && data.applicationType in ['school', 'teacher', 'student', 'academic', 'tc']
        && isValidId(data.schoolId) && data.schoolId.size() <= 64
        && data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120
        && isValidId(data.targetEntityId) && data.targetEntityId.size() <= 64
        && data.status in ['pending', 'under_review', 'approved', 'rejected', 'suspended']
        && data.details is string && data.details.size() <= 600
        && (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128))
        && (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLogRecord(data) {
      return data.keys().hasAll(['actorUid', 'actorRole', 'actionType', 'targetType', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorRole', 'actionType', 'targetType', 'targetId', 'summary', 'schoolId', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.actorRole in ['central_admin', 'school_admin', 'teacher', 'guardian', 'student']
        && data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 80
        && data.targetType in ['user', 'school', 'teacher', 'student', 'notice', 'exam', 'application', 'storage', 'system']
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidNoticeRecord(data) {
      return data.keys().hasAll(['noticeId', 'createdByUid', 'title', 'body', 'audience', 'priority', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['noticeId', 'createdByUid', 'schoolId', 'title', 'body', 'audience', 'priority', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.noticeId)
        && data.noticeId.size() <= 64
        && isValidId(data.createdByUid)
        && (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.audience in ['all', 'teachers', 'students', 'guardians', 'school']
        && data.priority in ['normal', 'important', 'urgent']
        && data.status in ['published', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLogRecord(data) {
      return data.keys().hasAll(['createdByUid', 'role', 'what', 'targetName', 'createdAt'])
        && data.keys().hasOnly(['createdByUid', 'role', 'what', 'targetName', 'schoolId', 'createdAt'])
        && isValidId(data.createdByUid)
        && data.createdByUid == request.auth.uid
        && data.role in ['central_admin', 'school_admin', 'teacher', 'guardian', 'student']
        && data.what is string && data.what.size() >= 1 && data.what.size() <= 240
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 240
        && (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64))
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidAppConfigRecord(data) {
      return data.keys().hasAll(['updatedByUid', 'webAppUrl', 'androidApkUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['updatedByUid', 'webAppUrl', 'androidApkUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.webAppUrl is string && data.webAppUrl.size() <= 500
        && data.androidApkUrl is string && data.androidApkUrl.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudBackupRecord(data) {
      return data.keys().hasAll([
          'ownerUid',
          'email',
          'role',
          'displayName',
          'language',
          'themePreference',
          'schoolCount',
          'teacherCount',
          'studentCount',
          'settingsVersion',
          'backupSettings',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'email',
          'role',
          'displayName',
          'language',
          'themePreference',
          'schoolCount',
          'teacherCount',
          'studentCount',
          'settingsVersion',
          'note',
          'backupSettings',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role in ['central_admin', 'school_admin', 'teacher', 'guardian', 'student', 'pending']
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.language in ['bn', 'en']
        && data.themePreference in ['light', 'dark', 'system']
        && data.schoolCount is int && data.schoolCount >= 0 && data.schoolCount <= 100000
        && data.teacherCount is int && data.teacherCount >= 0 && data.teacherCount <= 1000000
        && data.studentCount is int && data.studentCount >= 0 && data.studentCount <= 10000000
        && data.settingsVersion is int && data.settingsVersion >= 1 && data.settingsVersion <= 1000000
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.backupSettings is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMediaAssetRecord(data) {
      return data.keys().hasAll([
          'assetId',
          'ownerUid',
          'category',
          'scopeId',
          'fileName',
          'mimeType',
          'sizeBytes',
          'dataUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'assetId',
          'ownerUid',
          'category',
          'scopeId',
          'fileName',
          'mimeType',
          'sizeBytes',
          'dataUrl',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.assetId)
        && isValidId(data.ownerUid)
        && data.category in ['profile_photos', 'school_covers', 'documents', 'notices']
        && isValidId(data.scopeId) && data.scopeId.size() <= 64
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 500000
        && data.dataUrl is string && data.dataUrl.size() >= 10 && data.dataUrl.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isSuperCentralAdmin() || isReviewerAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperCentralAdmin() ||
          (isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().role == 'pending'
            && incoming().status == 'pending'
            && (!('isActive' in incoming()) || incoming().isActive == false))
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isSuperCentralAdmin() ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().status == existing().status
            && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isSuperCentralAdmin();

      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(userId) && docId == 'preferences' && (isOwner(userId) || isSuperCentralAdmin());
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'preferences'
          && isValidUserPreferences(incoming())
          && (isOwner(userId) || isSuperCentralAdmin())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'preferences'
          && isValidUserPreferences(incoming())
          && (isOwner(userId) || isSuperCentralAdmin())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['lang', 'theme', 'fontSize', 'pushNotifications', 'emailNotifications', 'updatedAt']);

        allow delete: if isVerifiedUser() && isValidId(userId) && docId == 'preferences' && (isOwner(userId) || isSuperCentralAdmin());
      }
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (isOwner(adminId) || isSuperCentralAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(adminId)
        && isSuperCentralAdmin()
        && isValidAdminRegistry(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(adminId)
        && isSuperCentralAdmin()
        && isValidAdminRegistry(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accessLevel', 'updatedAt']);

      allow delete: if isValidId(adminId) && isSuperCentralAdmin();
    }

    match /schools/{schoolId} {
      allow get: if isVerifiedUser() && isValidId(schoolId) && (existing().ownerUid == request.auth.uid || isSuperCentralAdmin() || isReviewerAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
