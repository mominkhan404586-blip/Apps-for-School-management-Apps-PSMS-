# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Unified Web + Android Deployment Configuration
VITE_API_BASE_URL="https://school-management-system-sms-798667902569.asia-southeast1.run.app"
VITE_LIVE_WEB_APP_URL="https://school-management-system-sms-798667902569.asia-southeast1.run.app"
VITE_ANDROID_APK_URL="https://github.com/mominkhan404586-blip/Apps-for-School-management-Apps-PSMS-/releases/latest/download/psms-android.apk"
VITE_GITHUB_REPO_URL="https://github.com/mominkhan404586-blip/Apps-for-School-management-Apps-PSMS-"

# Bulk SMS Gateway Configuration (Server-side ONLY - never prefix with VITE_)
# Supported SMS_PROVIDER values: auto | twilio | bd_sms_gateway | preview_sandbox
SMS_PROVIDER="auto"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
BD_SMS_API_URL=""
BD_SMS_API_KEY=""
BD_SMS_SENDER_ID=""

